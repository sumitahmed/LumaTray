import { Theme } from "theme.slint";
import { MonitorIcon, SunIcon, LinkIcon, GearIcon, RefreshIcon } from "icons.slint";
import { FluentSlider } from "slider.slint";
import { MonitorCard, DisplayItem } from "monitor_card.slint";
import { SettingsWindow } from "settings.slint";
import { WelcomeWindow } from "welcome.slint";

export { DisplayItem, Theme, SettingsWindow, WelcomeWindow }

export component MainWindow inherits Window {
    title: "LumaTray";
    icon: @image-url("../assets/tray.ico");
    no-frame: true;
    always-on-top: true;
    background: Theme.background;
    default-font-family: "Segoe UI Variable Text";

    preferred-width: 384px;
    preferred-height: container.preferred-height;

    out property <length> desired-height: container.preferred-height;

    in-out property <bool> is-dark <=> Theme.is-dark;
    in-out property <string> accent-id <=> Theme.accent-id;
    in-out property <[DisplayItem]> displays: [];
    in-out property <bool> sync-enabled: false;
    in-out property <int> master-brightness: 75;
    in property <string> status-text: "Ready";

    callback master-brightness-changed(int);
    callback monitor-brightness-changed(string, int);
    callback monitor-contrast-changed(string, int);
    callback toggle-sync-master();
    callback toggle-monitor-link(string);
    callback refresh-clicked();
    callback open-settings-clicked();
    callback open-github-clicked();
    callback drag-window();

    container := Rectangle {
        width: 100%;
        border-radius: Theme.radius-window;
        border-width: 1px;
        border-color: Theme.flyout-border;
        background: transparent;
        clip: true;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 12px;

            // Draggable Header Row
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                // Title (Draggable)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 9px;
                        cross-axis-alignment: center;

                        SunIcon {
                            icon-size: 19px;
                            icon-color: Theme.accent;
                        }

                        Text {
                            text: "LumaTray";
                            font-size: 14.5px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.drag-window();
                            }
                        }
                    }
                }

                // Sync Master Pill (Visible when multiple displays exist)
                if root.displays.length > 1 : Rectangle {
                    height: 30px;
                    border-radius: 15px;
                    background: root.sync-enabled ? Theme.accent-subtle : (sync-touch.has-hover ? Theme.control-hover : Theme.control-bg);
                    border-width: 1px;
                    border-color: root.sync-enabled ? Theme.accent : Theme.card-border;
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        LinkIcon {
                            icon-size: 13px;
                            icon-color: root.sync-enabled ? Theme.accent : Theme.text-secondary;
                        }

                        Text {
                            text: "Sync";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.sync-enabled ? Theme.accent : Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    Tooltip { text: @markdown("Sync with other displays"); }

                    sync-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.toggle-sync-master(); }
                    }
                }

                // Refresh Button
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-control;
                    background: refresh-touch.has-hover ? Theme.control-hover : transparent;
                    animate background { duration: 100ms; }

                    RefreshIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-size: 15px;
                        icon-color: refresh-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    Tooltip { text: @markdown("Refresh Displays"); }

                    refresh-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.refresh-clicked(); }
                    }
                }

                // Settings Button (Opens Dedicated Settings Window)
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-control;
                    background: settings-touch.has-hover ? Theme.control-hover : transparent;
                    animate background { duration: 100ms; }

                    GearIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-size: 15px;
                        icon-color: settings-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }

                    Tooltip { text: @markdown("Settings"); }

                    settings-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.open-settings-clicked(); }
                    }
                }
            }

            // Master Synchronized Slider (Shown when sync is active AND multiple displays exist)
            if root.sync-enabled && root.displays.length > 1 : Rectangle {
                border-radius: Theme.radius-card;
                background: Theme.accent-subtle;
                border-width: 1px;
                border-color: Theme.accent-border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        LinkIcon {
                            icon-size: 14px;
                            icon-color: Theme.accent;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "All Linked Displays";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;

                        SunIcon {
                            icon-size: 15px;
                            icon-color: Theme.accent;
                        }

                        FluentSlider {
                            horizontal-stretch: 1;
                            value: root.master-brightness;
                            minimum: 0;
                            maximum: 100;
                            changed(val) => {
                                root.master-brightness = val;
                                root.master-brightness-changed(val);
                            }
                            released(val) => {
                                root.master-brightness = val;
                                root.master-brightness-changed(val);
                            }
                        }
                    }
                }
            }

            // Per-Monitor Cards
            VerticalLayout {
                spacing: 10px;

                for disp in root.displays: MonitorCard {
                    display <=> disp;
                    display-count: root.displays.length;
                    sync-active: root.sync-enabled;
                    brightness-changed(id, val) => {
                        root.monitor-brightness-changed(id, val);
                    }
                    contrast-changed(id, val) => {
                        root.monitor-contrast-changed(id, val);
                    }
                    toggle-linked(id) => {
                        root.toggle-monitor-link(id);
                    }
                }
            }

            // Footer Status + Quick GitHub Link
            HorizontalLayout {
                padding-top: 2px;
                cross-axis-alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    font-size: 11px;
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: gh-footer-text.preferred-width + 4px;
                    height: 18px;
                    background: transparent;

                    gh-footer-text := Text {
                        text: "github.com/sumitahmed/LumaTray";
                        font-size: 10.5px;
                        color: gh-footer-touch.has-hover ? Theme.accent : Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    gh-footer-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-github-clicked();
                        }
                    }
                }
            }
        }
    }
}
