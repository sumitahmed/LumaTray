import { Theme } from "theme.slint";

export component MonitorIcon inherits Rectangle {
    in property <color> icon-color: Theme.text-primary;
    in property <length> icon-size: 16px;
    width: icon-size;
    height: icon-size;

    Path {
        width: 100%;
        height: 100%;
        fill: root.icon-color;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 20;
        viewbox-height: 20;
        // Screen border + stand + base
        commands: "M2 3 C2 1.9 2.9 1 4 1 L16 1 C17.1 1 18 1.9 18 3 L18 12 C18 13.1 17.1 14 16 14 L11 14 L11 16.5 L13.5 16.5 C13.78 16.5 14 16.72 14 17 C14 17.28 13.78 17.5 13.5 17.5 L6.5 17.5 C6.22 17.5 6 17.28 6 17 C6 16.72 6.22 16.5 6.5 16.5 L9 16.5 L9 14 L4 14 C2.9 14 2 13.1 2 12 Z M3.5 3 C3.5 2.72 3.72 2.5 4 2.5 L16 2.5 C16.28 2.5 16.5 2.72 16.5 3 L16.5 12 C16.5 12.28 16.28 12.5 16 12.5 L4 12.5 C3.72 12.5 3.5 12.28 3.5 12 Z";
    }
}

