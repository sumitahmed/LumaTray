export global Theme {
    in-out property <bool> is-dark: true;
    in-out property <string> accent-id: "cyan";

    // Window & Surface
    in-out property <color> background: is-dark ? #1e1e1e : #f3f3f3;
    in-out property <color> sidebar-bg: is-dark ? #181818 : #eaeaea;
    in-out property <color> card-bg: is-dark ? #282828 : #ffffff;
    in-out property <color> card-bg-hover: is-dark ? #303030 : #f8f8f8;
    in-out property <color> card-border: is-dark ? #ffffff14 : #00000012;
    in-out property <color> flyout-border: is-dark ? #ffffff22 : #0000001f;

    // Typography Colors
    in-out property <color> text-primary: is-dark ? #ffffff : #1a1a1a;
    in-out property <color> text-secondary: is-dark ? #d4d4d4 : #525252;
    in-out property <color> text-tertiary: is-dark ? #9a9a9a : #787878;
    in-out property <color> text-disabled: is-dark ? #ffffff40 : #b0b0b0;

    // Dynamic Accent Palette (6 presets: cyan, purple, emerald, amber, rose, blue)
    in-out property <color> accent:
        accent-id == "purple" ? (is-dark ? #b47cff : #7c3aed) :
        accent-id == "emerald" ? (is-dark ? #34d399 : #059669) :
        accent-id == "amber" ? (is-dark ? #fbbf24 : #d97706) :
        accent-id == "rose" ? (is-dark ? #fb7185 : #e11d48) :
        accent-id == "blue" ? (is-dark ? #60a5fa : #2563eb) :
        (is-dark ? #60cdff : #0067c0);

    in-out property <color> accent-hover:
        accent-id == "purple" ? (is-dark ? #c498ff : #6d28d9) :
        accent-id == "emerald" ? (is-dark ? #6ee7b7 : #047857) :
        accent-id == "amber" ? (is-dark ? #fcd34d : #b45309) :
        accent-id == "rose" ? (is-dark ? #fda4af : #be123c) :
        accent-id == "blue" ? (is-dark ? #93c5fd : #1d4ed8) :
        (is-dark ? #7ce8ff : #1879cd);

    in-out property <color> accent-subtle:
        accent-id == "purple" ? (is-dark ? #b47cff26 : #7c3aed1a) :
        accent-id == "emerald" ? (is-dark ? #34d39926 : #0596691a) :
        accent-id == "amber" ? (is-dark ? #fbbf2426 : #d977061a) :
        accent-id == "rose" ? (is-dark ? #fb718526 : #e11d481a) :
        accent-id == "blue" ? (is-dark ? #60a5fa26 : #2563eb1a) :
        (is-dark ? #60cdff26 : #0067c01a);

    in-out property <color> accent-border:
        accent-id == "purple" ? (is-dark ? #b47cff80 : #7c3aed4d) :
        accent-id == "emerald" ? (is-dark ? #34d39980 : #0596694d) :
        accent-id == "amber" ? (is-dark ? #fbbf2480 : #d977064d) :
        accent-id == "rose" ? (is-dark ? #fb718580 : #e11d484d) :
        accent-id == "blue" ? (is-dark ? #60a5fa80 : #2563eb4d) :
        (is-dark ? #60cdff80 : #0067c04d);

    // Control Elements
    in-out property <color> control-bg: is-dark ? #ffffff12 : #0000000c;
    in-out property <color> control-hover: is-dark ? #ffffff1f : #00000016;
    in-out property <color> control-active: is-dark ? #ffffff29 : #00000022;
    in-out property <color> slider-track: is-dark ? #ffffff2b : #00000026;
    in-out property <color> slider-thumb: is-dark ? #ffffff : #ffffff;
    in-out property <color> slider-thumb-border: is-dark ? #00000040 : #00000028;

    // Badges
    in-out property <color> badge-bg: is-dark ? #ffffff14 : #0000000f;
    in-out property <color> badge-text: is-dark ? #d4d4d4 : #525252;
    in-out property <color> badge-ddc-bg: accent-subtle;
    in-out property <color> badge-ddc-text: accent;

    // Danger / Reset
    in-out property <color> danger: is-dark ? #ff6b6b : #dc2626;
    in-out property <color> danger-subtle: is-dark ? #ff6b6b22 : #dc262618;
    in-out property <color> danger-border: is-dark ? #ff6b6b66 : #dc26264d;

    // Spacing & Radii
    in-out property <length> radius-window: 10px;
    in-out property <length> radius-card: 8px;
    in-out property <length> radius-control: 6px;
    in-out property <length> radius-pill: 20px;
}
