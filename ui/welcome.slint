import { Theme } from "theme.slint";
import { SunIcon, MonitorIcon, LinkIcon, GearIcon, ChevronUpIcon, CursorIcon } from "icons.slint";

export component WelcomeWindow inherits Window {
    title: "Welcome to LumaTray";
    icon: @image-url("../assets/tray.ico");
    preferred-width: 440px;
    preferred-height: 510px;
    background: Theme.background;
    default-font-family: "Segoe UI Variable Text";

    in-out property <bool> is-dark <=> Theme.is-dark;
    in-out property <string> accent-id <=> Theme.accent-id;
    in-out property <int> active-step: 0;

    callback close-clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: space-between;

        // Top Badge Emblem & Heading
        VerticalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            // Circular Emblem
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: Theme.accent-subtle;
                border-width: 2px;
                border-color: Theme.accent;

                SunIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 34px;
                    icon-color: Theme.accent;
                }
            }

            Text {
                text: "Hello, LumaTray!";
                font-size: 21px;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                width: 360px;
                text: "The tray icon for LumaTray is probably hidden in your taskbar overflow, so move it to your main taskbar for instant access. See below:";
                font-size: 12.5px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Interactive Step Indicator Pills
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            for item[idx] in [
                "1. Open Tray ^",
                "2. Pin to Taskbar",
                "3. Adjust Brightness"
            ] : Rectangle {
                height: 26px;
                border-radius: 13px;
                background: root.active-step == idx ? Theme.accent-subtle : Theme.control-bg;
                border-width: 1px;
                border-color: root.active-step == idx ? Theme.accent : Theme.card-border;
                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: item;
                        font-size: 11px;
                        font-weight: 600;
                        color: root.active-step == idx ? Theme.accent : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.active-step = idx;
                    }
                }
            }
        }

        // ==================== ANIMATED WALKTHROUGH STAGE ====================
        stage := Rectangle {
            width: 392px;
            height: 230px;
            border-radius: 8px;
            background: @linear-gradient(135deg, #0062b8 0%, #004282 60%, #002b59 100%);
            border-width: 1px;
            border-color: Theme.card-border;
            clip: true;

            // Subtle Windows Desktop Wallpaper Geometric Highlight
            Rectangle {
                x: -30px;
                y: -40px;
                width: 200px;
                height: 150px;
                background: #ffffff10;
                border-radius: 12px;
            }

            // --- STEP 0 & 1: Tray Overflow Popup Box ---
            if root.active-step == 0 || root.active-step == 1 : Rectangle {
                x: 170px;
                y: 92px;
                width: 106px;
                height: 82px;
                border-radius: 6px;
                background: #1f1f1feb;
                border-width: 1px;
                border-color: #ffffff26;

                // Grid of tray overflow icons
                Rectangle {
                    x: 16px; y: 14px; width: 16px; height: 16px; border-radius: 3px; background: #ffffff30;
                }
                Rectangle {
                    x: 45px; y: 14px; width: 16px; height: 16px; border-radius: 8px; background: #0078d4;
                }
                Rectangle {
                    x: 74px; y: 14px; width: 16px; height: 16px; border-radius: 3px; background: #10b98180;
                }
                Rectangle {
                    x: 16px; y: 46px; width: 16px; height: 16px; border-radius: 3px; background: #f43f5e99;
                }
                Rectangle {
                    x: 45px; y: 46px; width: 16px; height: 16px; border-radius: 3px; background: #ffffff30;
                }

                // LumaTray Icon in overflow (Step 0)
                if root.active-step == 0 : Rectangle {
                    x: 70px;
                    y: 42px;
                    width: 24px;
                    height: 24px;
                    border-radius: 5px;
                    background: Theme.accent-subtle;
                    border-width: 1px;
                    border-color: Theme.accent;

                    SunIcon {
                        x: 4px;
                        y: 4px;
                        icon-size: 16px;
                        icon-color: Theme.accent;
                    }
                }
            }

            // --- STEP 1: Dragging LumaTray Icon Toward Taskbar ---
            if root.active-step == 1 : Rectangle {
                x: 242px;
                y: 162px;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: #252525;
                border-width: 1.5px;
                border-color: Theme.accent;

                SunIcon {
                    x: 5px;
                    y: 5px;
                    icon-size: 18px;
                    icon-color: Theme.accent;
                }
            }

            // --- STEP 2: Mini Adjust Brightness Flyout Demo ---
            if root.active-step == 2 : Rectangle {
                x: 56px;
                y: 16px;
                width: 318px;
                height: 168px;
                border-radius: 8px;
                background: #1f1f1ff5;
                border-width: 1px;
                border-color: #ffffff28;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Flyout Demo Header
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        Text {
                            horizontal-stretch: 1;
                            text: "Adjust Brightness";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        LinkIcon {
                            icon-size: 14px;
                            icon-color: #bbbbbb;
                        }
                        Rectangle { width: 8px; }
                        GearIcon {
                            icon-size: 14px;
                            icon-color: #bbbbbb;
                        }
                    }

                    // Monitor 1 Demo Row
                    VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;
                            MonitorIcon { icon-size: 13px; icon-color: #ffffff; }
                            Text {
                                text: "EK240Y P6";
                                font-size: 11px;
                                font-weight: 600;
                                color: #ffffff;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: #ffffff30;

                                Rectangle {
                                    x: 0px;
                                    width: parent.width * 0.65;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                                Rectangle {
                                    x: parent.width * 0.65 - 5px;
                                    y: -4px;
                                    width: 10px;
                                    height: 12px;
                                    border-radius: 5px;
                                    background: Theme.accent;
                                }
                            }
                            Text {
                                width: 24px;
                                text: "65";
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    // Monitor 2 Demo Row
                    VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;
                            MonitorIcon { icon-size: 13px; icon-color: #ffffff; }
                            Text {
                                text: "Integrated Display";
                                font-size: 11px;
                                font-weight: 600;
                                color: #ffffff;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: #ffffff30;

                                Rectangle {
                                    x: 0px;
                                    width: parent.width * 0.35;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                                Rectangle {
                                    x: parent.width * 0.35 - 5px;
                                    y: -4px;
                                    width: 10px;
                                    height: 12px;
                                    border-radius: 5px;
                                    background: Theme.accent;
                                }
                            }
                            Text {
                                width: 24px;
                                text: "35";
                                font-size: 13px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }

            // --- SIMULATED WINDOWS TASKBAR AT BOTTOM OF STAGE ---
            Rectangle {
                x: 0px;
                y: parent.height - 38px;
                width: parent.width;
                height: 38px;
                background: #101010f2;
                border-width: 1px;
                border-color: #ffffff1a;

                // Tray Overflow Chevron Button (^)
                Rectangle {
                    x: 204px;
                    y: 5px;
                    width: 26px;
                    height: 28px;
                    border-radius: 4px;
                    background: root.active-step == 0 ? #ffffff22 : transparent;

                    ChevronUpIcon {
                        x: 6px;
                        y: 7px;
                        icon-size: 14px;
                        icon-color: #ffffff;
                    }
                }

                // Pinned LumaTray Icon on Taskbar (Visible in Step 2)
                if root.active-step == 2 : Rectangle {
                    x: 234px;
                    y: 5px;
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: #ffffff26;

                    SunIcon {
                        x: 6px;
                        y: 6px;
                        icon-size: 16px;
                        icon-color: Theme.accent;
                    }
                }

                // System Tray Network / Volume / Clock Mockup
                MonitorIcon {
                    x: 268px;
                    y: 11px;
                    icon-size: 15px;
                    icon-color: #dddddd;
                }

                Text {
                    x: 300px;
                    y: 6px;
                    text: "9:41 AM";
                    font-size: 10px;
                    color: #ffffff;
                }
                Text {
                    x: 300px;
                    y: 19px;
                    text: "LumaTray";
                    font-size: 9px;
                    color: #aaaaaa;
                }
            }

            // --- ANIMATED POINTER CURSOR ---
            CursorIcon {
                x: root.active-step == 0 ? 248px : (root.active-step == 1 ? 256px : 246px);
                y: root.active-step == 0 ? 144px : (root.active-step == 1 ? 178px : 204px);
                icon-size: 20px;
                animate x, y { duration: 350ms; easing: ease-in-out; }
            }
        }

        // Bottom Close Button
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 190px;
                height: 36px;
                border-radius: 6px;
                background: close-touch.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: 100ms; }

                Text {
                    text: "Close";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.is-dark ? #000000 : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.close-clicked();
                    }
                }
            }
        }
    }
}
