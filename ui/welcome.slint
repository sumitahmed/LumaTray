import { Theme } from "theme.slint";
import { SunIcon, MonitorIcon, LinkIcon, GearIcon, RefreshIcon, ChevronUpIcon, CursorIcon } from "icons.slint";

export component WelcomeWindow inherits Window {
    title: "Welcome to LumaTray";
    icon: @image-url("../assets/tray.ico");
    preferred-width: 580px;
    preferred-height: 540px;
    background: Theme.background;
    default-font-family: "Segoe UI Variable Text";

    in-out property <bool> is-dark <=> Theme.is-dark;
    in-out property <string> accent-id <=> Theme.accent-id;

    // Continuous 20 FPS timeline properties driven by Rust welcome_timer
    in-out property <int> active-step: 0;
    in-out property <float> global-progress: 0.0;
    in-out property <float> cursor-x: 260.0;
    in-out property <float> cursor-y: 190.0;
    in-out property <bool> cursor-pressed: false;
    in-out property <float> ripple-progress: 0.0;

    in-out property <bool> chev-hover: false;
    in-out property <bool> chev-open: false;
    in-out property <float> overflow-alpha: 0.0;
    in-out property <float> overflow-dy: 10.0;
    in-out property <bool> icon-in-overflow: true;
    in-out property <bool> icon-hover: false;

    in-out property <bool> dragging: false;
    in-out property <float> drag-x: 390.0;
    in-out property <float> drag-y: 210.0;
    in-out property <float> pinned-slot-t: 0.0;
    in-out property <bool> icon-pinned: false;
    in-out property <bool> tray-active: false;

    in-out property <float> flyout-alpha: 0.0;
    in-out property <float> flyout-dy: 12.0;
    in-out property <int> b1: 65;
    in-out property <int> b2: 40;
    in-out property <int> active-slider: 0;
    in-out property <float> wallpaper-dim: 0.15;

    callback close-clicked();
    callback step-selected(int);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: space-between;

        // Top Title & Subtitle
        VerticalLayout {
            spacing: 6px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                cross-axis-alignment: center;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.accent-subtle;
                    border-width: 1.5px;
                    border-color: Theme.accent;

                    SunIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-size: 20px;
                        icon-color: Theme.accent;
                    }
                }

                Text {
                    text: "Hello, LumaTray!";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }

            Text {
                width: 500px;
                text: "The LumaTray icon may start inside your Windows taskbar overflow. Drag it onto your main taskbar for one-click brightness control:";
                font-size: 12px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // ==================== STUDIO WALKTHROUGH STAGE (540 x 356) ====================
        stage := Rectangle {
            width: 540px;
            height: 356px;
            border-radius: 10px;
            background: @linear-gradient(160deg, #080e1c 0%, #0c1932 55%, #0e2142 100%);
            border-width: 1px;
            border-color: Theme.card-border;
            clip: true;

            // Windows 11 Dark Bloom Volumetric Layered Petals
            Rectangle {
                x: 45px;
                y: 55px;
                width: 340px;
                height: 250px;
                border-radius: 125px;
                background: @linear-gradient(135deg, #163fa688 0%, #2b1d7877 100%);
            }
            Rectangle {
                x: 90px;
                y: 80px;
                width: 255px;
                height: 185px;
                border-radius: 92px;
                background: @linear-gradient(135deg, #2592f277 0%, #1652b866 100%);
            }
            Rectangle {
                x: 130px;
                y: 105px;
                width: 175px;
                height: 125px;
                border-radius: 62px;
                background: #60cdff44;
            }

            // Real-time Brightness Dimming Overlay synced to slider b1
            Rectangle {
                width: 100%;
                height: 100%;
                background: #000000;
                opacity: root.wallpaper-dim;
            }

            // --- TOP FLOATING STEP PILL BAR ---
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 14px;
                width: 468px;
                height: 36px;
                border-radius: 18px;
                background: #181a20eb;
                border-width: 1px;
                border-color: #ffffff22;

                HorizontalLayout {
                    padding: 5px;
                    spacing: 4px;

                    for item[idx] in [
                        "1. Open Tray Overflow",
                        "2. Pin to Taskbar",
                        "3. Adjust Brightness"
                    ] : Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 13px;
                        background: root.active-step == idx ? #60cdff2b : transparent;
                        border-width: root.active-step == idx ? 1px : 0px;
                        border-color: root.active-step == idx ? #60cdffa8 : transparent;

                        Text {
                            text: item;
                            font-size: 10.5px;
                            font-weight: 600;
                            color: root.active-step == idx ? #76d8ff : (idx < root.active-step ? #d7e1eb : #969eaa);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.step-selected(idx); }
                        }
                    }
                }

                // Continuous Progress Line at bottom of pill
                Rectangle {
                    x: 18px;
                    y: parent.height - 2px;
                    width: (parent.width - 36px) * root.global-progress;
                    height: 2px;
                    border-radius: 1px;
                    background: #60cdff;
                }
            }

            // --- TRAY OVERFLOW POPUP ---
            if root.overflow-alpha > 0.01 : Rectangle {
                x: 336px;
                y: 356px - 40px - 84px - 10px + (root.overflow-dy * 1px);
                width: 118px;
                height: 84px;
                border-radius: 9px;
                background: #202228f5;
                border-width: 1px;
                border-color: #ffffff26;
                opacity: root.overflow-alpha;

                // 5 Muted System Tray Tiles
                Rectangle { x: 14px; y: 14px; width: 18px; height: 18px; border-radius: 4px; background: #738296bb; }
                Rectangle { x: 50px; y: 14px; width: 18px; height: 18px; border-radius: 4px; background: #2484e6bb; }
                Rectangle { x: 86px; y: 14px; width: 18px; height: 18px; border-radius: 4px; background: #22bc82bb; }
                Rectangle { x: 14px; y: 50px; width: 18px; height: 18px; border-radius: 4px; background: #e84c6cbb; }
                Rectangle { x: 50px; y: 50px; width: 18px; height: 18px; border-radius: 4px; background: #a076eebb; }

                // LumaTray Sun Tile in bottom-right slot of overflow
                if root.icon-in-overflow : Rectangle {
                    x: 82px;
                    y: 46px;
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: root.icon-hover ? #60cdff3d : #60cdff22;
                    border-width: 1px;
                    border-color: root.icon-hover ? #60cdff : #60cdff88;

                    SunIcon {
                        x: 5px;
                        y: 5px;
                        icon-size: 16px;
                        icon-color: #60cdff;
                    }
                }
            }

            // --- AUTHENTIC LUMATRAY v0.2.0 BRIGHTNESS FLYOUT ---
            if root.flyout-alpha > 0.01 : Rectangle {
                x: parent.width - self.width - 14px;
                y: 356px - 40px - self.height - 10px + (root.flyout-dy * 1px);
                width: 292px;
                height: 214px;
                border-radius: 10px;
                background: #1e1f23f8;
                border-width: 1px;
                border-color: #ffffff26;
                opacity: root.flyout-alpha;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Flyout Header
                    HorizontalLayout {
                        spacing: 7px;
                        cross-axis-alignment: center;

                        SunIcon { icon-size: 16px; icon-color: #60cdff; }
                        Text {
                            horizontal-stretch: 1;
                            text: "LumaTray";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }

                        // Sync Pill
                        Rectangle {
                            width: 52px;
                            height: 20px;
                            border-radius: 10px;
                            background: #ffffff14;
                            border-width: 1px;
                            border-color: #ffffff22;
                            Text {
                                text: "Sync";
                                font-size: 9px;
                                font-weight: 600;
                                color: #d8dce4;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        RefreshIcon { icon-size: 13px; icon-color: #bec4ce; }
                        GearIcon { icon-size: 13px; icon-color: #bec4ce; }
                    }

                    // Monitor 1 Card: EK240Y P6
                    Rectangle {
                        height: 68px;
                        border-radius: 7px;
                        background: #2a2b30;
                        border-width: 1px;
                        border-color: #ffffff18;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 7px;
                                cross-axis-alignment: center;
                                MonitorIcon { icon-size: 13px; icon-color: #ffffff; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: "EK240Y P6"; font-size: 11px; font-weight: 700; color: #ffffff; }
                                    Text { text: "1920 × 1080 • 144 Hz"; font-size: 8.5px; color: #9aa0aa; }
                                }
                                Rectangle {
                                    width: 44px;
                                    height: 17px;
                                    border-radius: 4px;
                                    background: #60cdff24;
                                    border-width: 1px;
                                    border-color: #60cdff77;
                                    Text {
                                        text: "DDC/CI";
                                        font-size: 8.5px;
                                        font-weight: 600;
                                        color: #60cdff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Slider 1
                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                SunIcon { icon-size: 12px; icon-color: #60cdff; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 16px;
                                    background: transparent;

                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 100%;
                                        height: root.active-slider == 1 ? 5px : 3.5px;
                                        border-radius: self.height / 2;
                                        background: #ffffff2a;
                                    }
                                    Rectangle {
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width * (root.b1 / 100.0);
                                        height: root.active-slider == 1 ? 5px : 3.5px;
                                        border-radius: self.height / 2;
                                        background: #60cdff;
                                    }
                                    Rectangle {
                                        x: parent.width * (root.b1 / 100.0) - 8px;
                                        y: (parent.height - 16px) / 2;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: #2e3036;
                                        border-width: 1px;
                                        border-color: #ffffff44;

                                        Rectangle {
                                            property <length> ds: root.active-slider == 1 ? 7px : 9px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: self.ds;
                                            height: self.ds;
                                            border-radius: self.ds / 2;
                                            background: #60cdff;
                                        }
                                    }
                                }
                                Text {
                                    width: 30px;
                                    text: root.b1 + "%";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Monitor 2 Card: Integrated Display
                    Rectangle {
                        height: 68px;
                        border-radius: 7px;
                        background: #2a2b30;
                        border-width: 1px;
                        border-color: #ffffff18;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 7px;
                                cross-axis-alignment: center;
                                MonitorIcon { icon-size: 13px; icon-color: #ffffff; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: "Integrated Display"; font-size: 11px; font-weight: 700; color: #ffffff; }
                                    Text { text: "1920 × 1200 • 60 Hz"; font-size: 8.5px; color: #9aa0aa; }
                                }
                                Rectangle {
                                    width: 44px;
                                    height: 17px;
                                    border-radius: 4px;
                                    background: #ffffff14;
                                    border-width: 1px;
                                    border-color: #ffffff22;
                                    Text {
                                        text: "Internal";
                                        font-size: 8.5px;
                                        font-weight: 600;
                                        color: #cdd2da;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Slider 2
                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                SunIcon { icon-size: 12px; icon-color: #60cdff; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 16px;
                                    background: transparent;

                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 100%;
                                        height: root.active-slider == 2 ? 5px : 3.5px;
                                        border-radius: self.height / 2;
                                        background: #ffffff2a;
                                    }
                                    Rectangle {
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width * (root.b2 / 100.0);
                                        height: root.active-slider == 2 ? 5px : 3.5px;
                                        border-radius: self.height / 2;
                                        background: #60cdff;
                                    }
                                    Rectangle {
                                        x: parent.width * (root.b2 / 100.0) - 8px;
                                        y: (parent.height - 16px) / 2;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: #2e3036;
                                        border-width: 1px;
                                        border-color: #ffffff44;

                                        Rectangle {
                                            property <length> ds: root.active-slider == 2 ? 7px : 9px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: self.ds;
                                            height: self.ds;
                                            border-radius: self.ds / 2;
                                            background: #60cdff;
                                        }
                                    }
                                }
                                Text {
                                    width: 30px;
                                    text: root.b2 + "%";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Footer
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "2 displays active";
                            font-size: 8.5px;
                            color: #9196a0;
                        }
                        Text {
                            text: "github.com/sumitahmed/LumaTray";
                            font-size: 8.5px;
                            color: #60cdff;
                        }
                    }
                }
            }

            // --- WINDOWS 11 FROSTED TASKBAR ---
            Rectangle {
                x: 0px;
                y: parent.height - 40px;
                width: parent.width;
                height: 40px;
                background: #16181ef0;
                border-width: 1px;
                border-color: #ffffff1a;

                // Centered Windows 11 Start Emblem & Search Pill
                Rectangle { x: 148px; y: 12px; width: 7px; height: 7px; border-radius: 1px; background: #4cc2ff; }
                Rectangle { x: 156px; y: 12px; width: 7px; height: 7px; border-radius: 1px; background: #28a8f0; }
                Rectangle { x: 148px; y: 20px; width: 7px; height: 7px; border-radius: 1px; background: #1894e8; }
                Rectangle { x: 156px; y: 20px; width: 7px; height: 7px; border-radius: 1px; background: #0078d4; }

                Rectangle {
                    x: 172px;
                    y: 10px;
                    width: 60px;
                    height: 20px;
                    border-radius: 10px;
                    background: #ffffff16;
                    border-width: 1px;
                    border-color: #ffffff1a;
                    Text {
                        text: "Search";
                        font-size: 8.5px;
                        color: #b9c0cc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { x: 242px; y: 12px; width: 16px; height: 16px; border-radius: 4px; background: #ebb234cc; }
                Rectangle { x: 266px; y: 12px; width: 16px; height: 16px; border-radius: 4px; background: #348ae8cc; }

                // Tray Overflow Chevron (^) — Smoothly shifts left by 28px when drop slot opens
                Rectangle {
                    x: 382px - (root.pinned-slot-t * 28px);
                    y: 6px;
                    width: 24px;
                    height: 28px;
                    border-radius: 5px;
                    background: (root.chev-hover || root.chev-open) ? #ffffff1e : transparent;

                    ChevronUpIcon {
                        x: 5px;
                        y: 7px;
                        icon-size: 14px;
                        icon-color: #ebeff5;
                    }
                }

                // Glowing Drop Slot during Drag
                if root.pinned-slot-t > 0.05 && !root.icon-pinned : Rectangle {
                    x: 382px;
                    y: 6px;
                    width: 24px;
                    height: 28px;
                    border-radius: 5px;
                    background: #60cdff26;
                    border-width: 1px;
                    border-color: #60cdffaa;
                    opacity: root.pinned-slot-t;
                }

                // Pinned LumaTray Icon on Taskbar
                if root.icon-pinned : Rectangle {
                    x: 382px;
                    y: 6px;
                    width: 24px;
                    height: 28px;
                    border-radius: 5px;
                    background: root.tray-active ? #ffffff28 : #ffffff14;

                    SunIcon {
                        x: 4px;
                        y: 6px;
                        icon-size: 16px;
                        icon-color: #60cdff;
                    }

                    if root.tray-active : Rectangle {
                        x: 7px;
                        y: parent.height - 3px;
                        width: 10px;
                        height: 2px;
                        border-radius: 1px;
                        background: #60cdff;
                    }
                }

                // System Tray Icons & Clock
                MonitorIcon { x: 422px; y: 13px; icon-size: 14px; icon-color: #e2e6ee; }
                Text { x: 478px; y: 7px; text: "9:41 AM"; font-size: 9px; color: #f2f5fa; }
                Text { x: 472px; y: 20px; text: "11/21/2026"; font-size: 8px; color: #bec6d2; }
            }

            // --- FLOATING DRAGGED ICON ---
            if root.dragging : Rectangle {
                x: (root.drag-x * 1px) - 15px;
                y: (root.drag-y * 1px) - 15px;
                width: 30px;
                height: 30px;
                border-radius: 7px;
                background: #202a36f5;
                border-width: 1.5px;
                border-color: #60cdff;

                SunIcon {
                    x: 6px;
                    y: 6px;
                    icon-size: 18px;
                    icon-color: #60cdff;
                }
            }

            // --- EXPANDING CLICK RIPPLE RING ---
            if root.ripple-progress > 0.01 && root.ripple-progress < 0.99 : Rectangle {
                property <length> r-sz: (8px + root.ripple-progress * 34px);
                x: (root.cursor-x * 1px) - self.r-sz / 2;
                y: (root.cursor-y * 1px) - self.r-sz / 2;
                width: self.r-sz;
                height: self.r-sz;
                border-radius: self.r-sz / 2;
                background: transparent;
                border-width: 2px;
                border-color: #60cdff;
                opacity: 1.0 - root.ripple-progress;
            }

            // --- ANIMATED CURSOR ---
            CursorIcon {
                x: root.cursor-x * 1px;
                y: root.cursor-y * 1px;
                icon-size: root.cursor-pressed ? 17px : 19px;
            }
        }

        // Bottom Close Button
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 200px;
                height: 36px;
                border-radius: 6px;
                background: close-touch.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: 100ms; }

                Text {
                    text: "Close";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.is-dark ? #000000 : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.close-clicked();
                    }
                }
            }
        }
    }
}
