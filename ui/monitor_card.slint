import { Theme } from "theme.slint";
import { MonitorIcon, SunIcon, ContrastIcon, LinkIcon } from "icons.slint";
import { FluentSlider } from "slider.slint";

export struct DisplayItem {
    id: string,
    name: string,
    gdi-name: string,
    resolution: string,
    refresh-rate: int,
    driver-type: string,
    brightness: int,
    contrast: int,
    min-limit: int,
    max-limit: int,
    has-contrast: bool,
    show-contrast: bool,
    is-linked: bool,
    is-accessible: bool,
}

export component MonitorCard inherits Rectangle {
    in-out property <DisplayItem> display;
    in property <int> display-count: 1;
    in property <bool> sync-active: false;

    callback brightness-changed(string, int);
    callback contrast-changed(string, int);
    callback toggle-linked(string);

    border-radius: Theme.radius-card;
    background: card-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-width: 1px;
    border-color: (root.display.is-linked && root.sync-active && root.display-count > 1) ? Theme.accent-border : Theme.card-border;
    animate background, border-color { duration: 120ms; }

    card-touch := TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        width: 100%;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;

        // Header Row: Monitor Icon + Name + Refresh Rate + Driver Badge + Link Button
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            MonitorIcon {
                icon-size: 16px;
                icon-color: root.display.is-linked && root.sync-active && root.display-count > 1 ? Theme.accent : Theme.text-primary;
                Tooltip { text: @markdown("Connected Display"); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 1px;

                Text {
                    text: root.display.name;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: root.display.resolution + " • " + root.display.refresh-rate + " Hz";
                    font-size: 10px;
                    color: Theme.text-tertiary;
                }
            }

            // Driver Badge
            Rectangle {
                height: 22px;
                border-radius: 5px;
                background: root.display.driver-type == "ddc_ci" ? Theme.badge-ddc-bg : Theme.badge-bg;
                border-width: 1px;
                border-color: root.display.driver-type == "ddc_ci" ? Theme.accent-border : Theme.card-border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: root.display.driver-type == "ddc_ci" ? "DDC/CI" : "Internal";
                        font-size: 10px;
                        font-weight: 600;
                        color: root.display.driver-type == "ddc_ci" ? Theme.badge-ddc-text : Theme.badge-text;
                        vertical-alignment: center;
                    }
                }

                Tooltip {
                    text: root.display.driver-type == "ddc_ci"
                        ? @markdown("Hardware DDC/CI VCP 0x10 bus")
                        : @markdown("Windows WMI internal panel driver");
                }
            }

            // Link Toggle (Visible when multiple displays exist)
            if root.display-count > 1 : Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: root.display.is-linked ? Theme.accent-subtle : (link-touch.has-hover ? Theme.control-hover : transparent);
                border-width: 1px;
                border-color: root.display.is-linked ? Theme.accent-border : Theme.card-border;
                animate background { duration: 100ms; }

                LinkIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 13px;
                    icon-color: root.display.is-linked ? Theme.accent : (link-touch.has-hover ? Theme.text-primary : Theme.text-tertiary);
                }

                Tooltip { text: @markdown("Sync with other displays"); }

                link-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-linked(root.display.id);
                    }
                }
            }
        }

        // Brightness Slider Row
        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            SunIcon {
                icon-size: 15px;
                icon-color: Theme.accent;
                Tooltip { text: @markdown("Brightness"); }
            }

            FluentSlider {
                horizontal-stretch: 1;
                value: root.display.brightness;
                minimum: 0;
                maximum: 100;
                enabled: root.display.is-accessible;
                changed(val) => {
                    root.display.brightness = val;
                    root.brightness-changed(root.display.id, val);
                }
                released(val) => {
                    root.display.brightness = val;
                    root.brightness-changed(root.display.id, val);
                }
            }
        }

        // Optional Hardware Contrast Slider Row (shown only if enabled in Settings)
        if root.display.has-contrast && root.display.show-contrast : HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            ContrastIcon {
                icon-size: 15px;
                icon-color: Theme.text-secondary;
                Tooltip { text: @markdown("Hardware Contrast (VCP 0x12)"); }
            }

            FluentSlider {
                horizontal-stretch: 1;
                value: root.display.contrast;
                minimum: 0;
                maximum: 100;
                enabled: root.display.is-accessible;
                changed(val) => {
                    root.display.contrast = val;
                    root.contrast-changed(root.display.id, val);
                }
                released(val) => {
                    root.display.contrast = val;
                    root.contrast-changed(root.display.id, val);
                }
            }
        }
    }
}
