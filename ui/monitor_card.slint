import { Theme } from "theme.slint";
import { MonitorIcon, SunIcon, LinkIcon } from "icons.slint";
import { FluentSlider } from "slider.slint";

export struct DisplayItem {
    id: string,
    name: string,
    driver-type: string,
    brightness: int,
    contrast: int,
    has-contrast: bool,
    is-linked: bool,
    is-accessible: bool,
}

export component MonitorCard inherits Rectangle {
    in-out property <DisplayItem> display;
    in property <int> display-count: 1;
    in property <bool> sync-active: false;

    callback brightness-changed(string, int);
    callback toggle-linked(string);

    border-radius: Theme.radius-card;
    background: card-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-width: 1px;
    border-color: Theme.card-border;
    animate background { duration: 120ms; }

    card-touch := TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;

        // Header Row
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            MonitorIcon {
                icon-size: 16px;
                icon-color: root.display.is-linked && root.sync-active ? Theme.accent : Theme.text-primary;
                Tooltip { text: @markdown("Connected Display"); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.display.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }

            // Driver Badge
            Rectangle {
                height: 22px;
                border-radius: 4px;
                background: root.display.driver-type == "ddc_ci" ? Theme.badge-ddc-bg : Theme.badge-bg;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: root.display.driver-type == "ddc_ci" ? "DDC/CI" : "Internal";
                        font-size: 10px;
                        font-weight: 600;
                        color: root.display.driver-type == "ddc_ci" ? Theme.badge-ddc-text : Theme.badge-text;
                        vertical-alignment: center;
                    }
                }

                Tooltip {
                    text: root.display.driver-type == "ddc_ci"
                        ? @markdown("Hardware DDC/CI communication bus")
                        : @markdown("Windows WMI internal backlight driver");
                }
            }

            // Link Toggle (ONLY visible when multiple displays exist)
            if root.display-count > 1 : link-btn := Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 5px;
                background: root.display.is-linked ? Theme.accent-subtle : (link-touch.has-hover ? Theme.control-hover : transparent);
                border-width: root.display.is-linked ? 1px : 0px;
                border-color: root.display.is-linked ? Theme.accent-border : transparent;
                animate background { duration: 100ms; }

                LinkIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 14px;
                    icon-color: root.display.is-linked ? Theme.accent : (link-touch.has-hover ? Theme.text-primary : Theme.text-tertiary);
                }

                Tooltip { text: @markdown("Sync with other displays"); }

                link-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.toggle-linked(root.display.id);
                    }
                }
            }
        }

        // Brightness Slider Row
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            SunIcon {
                icon-size: 15px;
                icon-color: Theme.text-secondary;
                Tooltip { text: @markdown("Brightness"); }
            }

            FluentSlider {
                horizontal-stretch: 1;
                value: root.display.brightness;
                minimum: 0;
                maximum: 100;
                enabled: root.display.is-accessible;
                changed(val) => {
                    root.display.brightness = val;
                    root.brightness-changed(root.display.id, val);
                }
                released(val) => {
                    root.display.brightness = val;
                    root.brightness-changed(root.display.id, val);
                }
            }
        }
    }
}
